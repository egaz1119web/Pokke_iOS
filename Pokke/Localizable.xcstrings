    "ai_disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs entirely on your device — nothing is sent anywhere. Answers can be wrong, so open the link to check."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理はすべてこの端末の中で行われ、リンクの内容が外に送られることはありません。答えが正しいとは限らないので、気になったらリンクを開いて確かめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 처리는 이 기기 안에서 이루어지며, 링크 내용이 밖으로 전송되지 않습니다. 답이 정확하지 않을 수 있으니 링크를 열어 확인해 주세요."
          }
        }
      }
    },
    "ai_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't answer that. Try asking again, or word it differently."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまく答えられませんでした。もう一度聞くか、聞き方を変えてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답하지 못했습니다. 다시 묻거나 다르게 물어봐 주세요."
          }
        }
      }
    },
    "ai_error_apple_intelligence_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
