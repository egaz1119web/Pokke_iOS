    "onboarding_share_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share sheet slides up. Scroll the row of apps to the end and tap “More”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有シートが下から出てきます。アプリの列を右端までたどり、「その他」を押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 시트가 아래에서 올라옵니다. 앱이 늘어선 줄을 오른쪽 끝까지 넘겨 “기타”를 누릅니다."
          }
        }
      }
    },
    "onboarding_share_step1_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If “Save to Pokke” is already in the row, just tap it."
          }
        },
