    "onboarding_intro_lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokke keeps the links you meant to read later, so they stop piling up in open tabs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokkeは「あとで読もう」と思ったリンクをためておくアプリです。開いたままのタブに埋もれさせません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokke는 \"나중에 읽어야지\" 하고 미뤄 둔 링크를 모아 두는 앱입니다. 열어 둔 탭 속에 묻히지 않게 해 줍니다."
          }
        }
      }
    },
    "onboarding_intro_point_preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles and thumbnails are added for you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルとサムネイルは自動で付く"
          }
