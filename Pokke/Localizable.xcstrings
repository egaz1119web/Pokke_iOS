          }
        }
      }
    },
    "delete_account_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, the links, collections and tags saved in the cloud, and everything stored on this device will be deleted. You'll be signed out and this can't be undone. You'll be asked to sign in once more to confirm it's you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントと、クラウドに保存したリンク・コレクション・タグ、そしてこの端末に保存した内容をすべて削除します。ログインも解除され、取り消せません。確認のためもう一度ログインを求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 클라우드에 저장한 링크·컬렉션·태그, 그리고 이 기기에 저장된 내용을 모두 삭제합니다. 로그아웃되며 취소할 수 없습니다. 본인 확인을 위해 한 번 더 로그인을 요청합니다."
          }
        }
      }
    },
