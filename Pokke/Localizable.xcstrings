    "tour_add_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can paste a URL here too, without leaving Pokke."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリを開かなくても、ここにURLを貼り付けて保存できます。"
