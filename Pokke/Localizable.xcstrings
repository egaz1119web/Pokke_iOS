    "tour_add_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save with +"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋からも保存できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋로도 저장할 수 있습니다"
          }
        }
      }
    },
    "tour_filter_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read something? Move it to the archive from the link's detail view, and the unread list stays short."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み終わったリンクは、詳細画面からアーカイブへ移せます。未読の側には、まだ読んでいない物だけが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 읽은 링크는 상세 화면에서 보관함으로 옮길 수 있습니다. 안 읽음 쪽에는 아직 읽지 않은 링크만 남습니다."
          }
        }
      }
    },
    "tour_filter_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unread and archive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読とアーカイブ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안 읽음과 보관함"
          }
        }
      }
    },
    "tour_nav_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group saved links into collections, find them again with search, or reopen this guide from Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したリンクはコレクションにまとめたり、検索で探したりできます。この案内は設定からいつでも見返せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 링크는 컬렉션으로 묶거나 검색으로 찾을 수 있습니다. 이 안내는 설정에서 언제든지 다시 볼 수 있습니다."
          }
        }
      }
    },
