    "report_thumbnail_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report a display problem"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示がおかしいことを知らせる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 문제 알리기"
          }
        }
      }
    },
    "report_thumbnail_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a thumbnail or title is missing, or shows the wrong thing, let us know. Some sites only reveal preview info to their own crawlers, so we have to add support site by site — %1$@ in this case."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サムネイルやタイトルが出ない、内容が違うといったことがあれば知らせてください。サイトによってはプレビュー用の情報を自社のクローラにしか返さないため、こちらでサイトごとに対応する必要があります（今回は %1$@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기나 제목이 안 나오거나 내용이 다르면 알려주세요. 일부 사이트는 미리보기 정보를 자사 크롤러에만 제공해서, 사이트별로 따로 대응해야 합니다(이번에는 %1$@)."
          }
        }
      }
    },
    "report_thumbnail_form_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This opens a Google Form with the above filled in. Nothing is sent until you tap Submit there, and you can edit or clear any field first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の内容を入れたGoogleフォームが開きます。フォームで「送信」を押すまで何も送られません。項目の編集も削除もできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 내용이 입력된 Google 설문지가 열립니다. 설문지에서 '제출'을 누르기 전까지는 아무것도 전송되지 않으며, 각 항목을 수정하거나 지울 수 있습니다."
          }
        }
      }
    },
    "report_thumbnail_include_url": {
      "extractionState": "manual",
      "localizations": {
