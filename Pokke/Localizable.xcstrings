    "delete_account_error_cloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't delete your cloud data (%1$@). Your account was kept — check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドのデータを削除できませんでした（%1$@）。アカウントは残してあります。通信状況を確かめてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 데이터를 삭제하지 못했습니다(%1$@). 계정은 그대로 두었습니다. 연결을 확인하고 다시 시도해 주세요."
          }
        }
      }
    },
    "delete_account_error_generic": {
