    "onboarding_share_tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time, Pokke usually isn't in the front row yet — it's inside the list behind “More”. Save once this way and it starts showing up in the front row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めて使うときは、Pokkeが最初の画面に並んでいないことがほとんどです。「その他」を開いた一覧の中にいます。この手順でいちど保存すると、次からは最初の画面にも出てくるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음에는 Pokke가 앞줄에 없는 경우가 대부분입니다. “기타”를 열면 나오는 목록 안에 있습니다. 이 방법으로 한 번 저장하면 다음부터는 앞줄에도 나타납니다."
          }
        }
      }
    },
