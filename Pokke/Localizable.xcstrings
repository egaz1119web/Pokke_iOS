    "onboarding_pin_lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can reorder the share sheet yourself — set it up once and Pokke will be right there whenever you share. When you're ready, open the share sheet with the button below and tap “Save to Pokke”:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有シートの並び順は自分で変えられます。一度だけ設定しておくと、どのアプリから共有してもPokkeがすぐ見つかります。見終わったら下のボタンで共有シートを開き、「Pokkeに保存」をタップしてみましょう："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 시트의 순서는 직접 바꿀 수 있어요. 한 번만 설정해 두면 어디서 공유해도 Pokke가 바로 보입니다. 준비되면 아래 버튼으로 공유 시트를 열고 ‘Pokke에 저장’을 탭해 보세요:"
          }
        }
      }
    },
    "onboarding_pin_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Pokke up front"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokkeを先頭に置こう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokke를 맨 앞에 두기"
          }
        }
      }
    },
    "onboarding_practice_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you can't find Pokke, tap “More” at the end of the row of apps. “Save to Pokke” is in the list that opens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokkeが見当たらないときは、アプリの列の右端にある「その他」を押してください。開いた一覧の中に「Pokkeに保存」があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokke가 보이지 않으면 앱 줄 오른쪽 끝의 “기타”를 눌러 주세요. 열린 목록 안에 “Pokke에 저장”이 있습니다."
          }
        }
      }
    },
    "onboarding_practice_lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The button below opens the share sheet. Pick “Save to Pokke” from the apps listed there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のボタンを押すと共有シートが開きます。並んでいるアプリの中から「Pokkeに保存」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 버튼을 누르면 공유 시트가 열립니다. 늘어선 앱 중에서 “Pokke에 저장”을 골라 주세요."
          }
        }
      }
    },
    "onboarding_practice_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shares Pokke's own page for practice. You can delete the saved link afterwards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習用にPokkeの紹介ページを共有します。保存されたリンクはあとで削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습용으로 Pokke 소개 페이지를 공유합니다. 저장된 링크는 나중에 삭제할 수 있습니다."
          }
        }
      }
    },
    "onboarding_practice_other_apps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also try it from another app, like a browser or a social app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザやSNSなど、他のアプリの共有から試してもかまいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저나 SNS 등 다른 앱의 공유에서 시도해도 됩니다."
          }
        }
      }
    },
    "onboarding_practice_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's try it once"
          }
        },
        "ja": {
          "stringUnit": {
