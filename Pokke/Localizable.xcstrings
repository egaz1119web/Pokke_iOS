          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 Apple Intelligence를 켜면 사용할 수 있습니다."
          }
        }
      }
    },
    "ai_error_model_not_ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device AI is still getting ready. Try again in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内AIの準備がまだ済んでいません。少ししてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 AI가 아직 준비되지 않았습니다. 잠시 후 다시 시도해 주세요."
          }
        }
      }
    },
    "ai_error_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device AI isn't available on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では、端末内AIを使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 기기 내 AI를 쓸 수 없습니다."
          }
        }
      }
    },
    "ai_instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are the assistant of Pokke, an app for saving links to read later. Below is an overview of everything the user saved (totals, date range, most common sites and tags), followed by only some of the links in detail with the date each was saved. There are saved links not shown in detail, so never say the detailed list is everything. Answer the question using only what is given, in English, in three sentences or less. When you mention a link, use its title. If the list doesn't say, reply that you can't tell from the saved links — never make anything up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは、あとで読むリンクを保存するアプリ「Pokke」のアシスタントです。次に、保存済み全体の要約（件数・期間・よく使うサイトとタグ）と、そのうち一部のリンクだけを保存日つきで詳しく示します。詳しく載っていないリンクもあるので、詳細の一覧が全部だとは言わないでください。示されたものだけを根拠に、日本語で3文以内で簡潔に答えてください。リンクを挙げるときはタイトルで示します。一覧に書かれていないことを聞かれたら「保存されたリンクからは分かりません」と答え、推測で補わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 나중에 읽을 링크를 저장하는 앱 'Pokke'의 어시스턴트입니다. 아래에는 저장된 전체의 요약(개수·기간·자주 쓰는 사이트와 태그)과, 그중 일부 링크만 저장한 날짜와 함께 자세히 적혀 있습니다. 자세히 적히지 않은 링크도 있으므로 상세 목록이 전부라고 말하지 마세요. 주어진 것만을 근거로 한국어로 세 문장 이내로 간결하게 답하세요. 링크를 언급할 때는 제목으로 가리킵니다. 목록에 없는 내용은 '저장된 링크만으로는 알 수 없습니다'라고 답하고, 추측으로 채우지 마세요."
          }
        }
      }
    },
