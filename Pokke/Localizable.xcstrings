    "onboarding_done_lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's the whole flow. From now on, every link you share lands on your home list."
          }
        },
        "ja": {
