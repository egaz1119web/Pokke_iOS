<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 共有拡張と stash.json を共有するための App Group。
	     アプリ本体と PokkeShare の両方に同じIDを入れておくこと。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.egaz.stash</string>
	</array>
	<!-- App Store 審査ガイドライン4.8対応（Googleログインだけだと却下される）。
	     Apple Developer PortalのApp IDでも Sign in with Apple のCapabilityを
	     有効にしておくこと。RELEASE.md参照 -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
